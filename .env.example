# Local Compose PostgreSQL defaults only. Replace them outside local development.
POSTGRES_DB=commerce_operations
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_PORT=55432
COMMERCE_ENVIRONMENT=local
COMMERCE_DEBUG=false
COMMERCE_LOG_LEVEL=INFO
COMMERCE_DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:55432/commerce_operations
COMMERCE_DEMO_MODE=false
COMMERCE_DATABASE_POOL_SIZE=5
COMMERCE_DATABASE_MAX_OVERFLOW=5
COMMERCE_DATABASE_CONNECT_TIMEOUT_SECONDS=5
COMMERCE_DATABASE_STARTUP_TIMEOUT_SECONDS=60
COMMERCE_CORS_ORIGINS=[]
# Enable authentication outside trusted local development. Values are JSON maps.
COMMERCE_API_AUTH_ENABLED=false
COMMERCE_API_KEYS={}
COMMERCE_API_ROLES={}
COMMERCE_RATE_LIMIT_REQUESTS=120
COMMERCE_RATE_LIMIT_WINDOW_SECONDS=60
COMMERCE_METRICS_ENABLED=true
COMMERCE_ERROR_REPORTING_ENABLED=false
COMMERCE_AI_MONTHLY_SPENDING_LIMIT=
COMMERCE_WORKFLOW_SPENDING_LIMIT=
COMMERCE_SPENDING_CURRENCY=USD
# Required for dashboard access in production. Inject from a secret store.
COMMERCE_DASHBOARD_ACCESS_KEY=
COMMERCE_DASHBOARD_CURRENCY=GBP
COMMERCE_SIGNIFICANT_PRICE_CHANGE_PERCENT=10
COMMERCE_PRICING_TARGET_MARGIN=0.30
COMMERCE_PRICING_MINIMUM_MARGIN=0.15
COMMERCE_PRICING_MINIMUM_PRICE=0
COMMERCE_PRICING_MAXIMUM_PRICE=
COMMERCE_PRICING_ROUNDING_INCREMENT=0.01
COMMERCE_REFUND_APPROVAL_THRESHOLD=50
COMMERCE_DEFAULT_APPROVAL_EXPIRY_HOURS=72
COMMERCE_WORKFLOW_MAX_ATTEMPTS=3
COMMERCE_WORKFLOW_TIMEOUT_SECONDS=300
COMMERCE_WORKFLOW_RETRY_DELAY_SECONDS=30
COMMERCE_WORKER_POLL_INTERVAL_SECONDS=2
COMMERCE_WORKER_BATCH_SIZE=100
COMMERCE_WORKER_HEARTBEAT_PATH=/tmp/commerce-worker-heartbeat
COMMERCE_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
COMMERCE_REORDER_TARGET_MULTIPLIER=2
COMMERCE_MARKETPLACE_HTTP_TIMEOUT_SECONDS=30
COMMERCE_ENABLED_MARKETPLACES=[]
# Marketplace credentials are optional until a connector is enabled. Never commit real values.
COMMERCE_EBAY_ACCESS_TOKEN=
COMMERCE_EBAY_ACCOUNT_ID=
COMMERCE_EBAY_ENDPOINT=https://api.sandbox.ebay.com
COMMERCE_EBAY_MARKETPLACE_ID=EBAY_GB
COMMERCE_EBAY_MERCHANT_LOCATION_KEY=
COMMERCE_EBAY_CATEGORY_ID=
COMMERCE_EBAY_FULFILLMENT_POLICY_ID=
COMMERCE_EBAY_PAYMENT_POLICY_ID=
COMMERCE_EBAY_RETURN_POLICY_ID=
COMMERCE_AMAZON_ACCESS_TOKEN=
COMMERCE_AMAZON_SELLER_ID=
COMMERCE_AMAZON_MARKETPLACE_ID=
COMMERCE_AMAZON_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
COMMERCE_FACEBOOK_ACCESS_TOKEN=
COMMERCE_FACEBOOK_CATALOG_ID=
COMMERCE_FACEBOOK_COMMERCE_ACCOUNT_ID=
COMMERCE_FACEBOOK_ENDPOINT=https://graph.facebook.com
COMMERCE_FACEBOOK_API_VERSION=v23.0
COMMERCE_TIKTOK_ACCESS_TOKEN=
COMMERCE_TIKTOK_APP_KEY=
COMMERCE_TIKTOK_APP_SECRET=
COMMERCE_TIKTOK_SHOP_CIPHER=
COMMERCE_TIKTOK_ENDPOINT=https://open-api.tiktokglobalshop.com
